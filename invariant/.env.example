# Read step. Leave READ_BACKEND unset to auto-pick: gemini if GEMINI_API_KEY is set, else anthropic, else stub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
READ_MODEL=claude-opus-5-5
# READ_BACKEND=stub

# Crustdata. With no key the client runs in mock mode off ./mocks/*.json
CRUSTDATA_API_KEY=
# CRUSTDATA_MODE=mock

# ceilings per run
MAX_SECONDS=90
MAX_CREDITS=400
