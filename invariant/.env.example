# Read step. Leave READ_BACKEND unset to auto-pick: anthropic if a key exists, else stub.
ANTHROPIC_API_KEY=
READ_MODEL=claude-sonnet-4-5
# READ_BACKEND=stub

# Crustdata. With no key the client runs in mock mode off ./mocks/*.json
CRUSTDATA_API_KEY=
# CRUSTDATA_MODE=mock

# ceilings per run
MAX_SECONDS=90
MAX_CREDITS=400
